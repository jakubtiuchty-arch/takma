// TAKMA e-commerce — Prisma schema
// PostgreSQL, modele: Customer, Order, OrderItem

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  AWAITING_PAYMENT
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum PaymentMethod {
  ONLINE
  PROFORMA
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
  REJECTED
}

enum AdminRole {
  ADMIN
  MANAGER
}

// ---------------------------------------------------------------------------
// Customer
// ---------------------------------------------------------------------------

model Customer {
  id                String    @id @default(cuid())
  email             String    @unique
  firstName         String
  lastName          String
  company           String
  nip               String?
  phone             String?
  address           String?
  shippingAddress   String?
  stripeCustomerId  String?   @unique
  hashedPassword    String?   // null = customer has not activated account yet
  isActive          Boolean   @default(false)
  activatedAt       DateTime?

  orders            Order[]
  quotes            Quote[]
  devices           Device[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Device (customer equipment tracking)
// ---------------------------------------------------------------------------

model Device {
  id              String    @id @default(cuid())

  customer        Customer  @relation(fields: [customerId], references: [id])
  customerId      String

  productName     String    // e.g. "Zebra TC22"
  productSlug     String?   // link to product page
  partNumber      String?
  serialNumber    String?

  purchaseDate    DateTime?
  warrantyEnd     DateTime?
  oneCareEnd      DateTime? // Zebra OneCare service contract

  notes           String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Order
// ---------------------------------------------------------------------------

model Order {
  id                     String        @id @default(cuid())
  orderNumber            String        @unique
  status                 OrderStatus   @default(PENDING_PAYMENT)

  customer               Customer      @relation(fields: [customerId], references: [id])
  customerId             String

  subtotalNetto          Int
  vatAmount              Int
  shippingNetto          Int           @default(0)
  totalBrutto            Int

  paymentMethod          PaymentMethod @default(ONLINE)
  stripeSessionId        String?
  stripePaymentIntentId  String?

  proformaUrl            String?
  proformaSentAt         DateTime?
  paidAt                 DateTime?

  ingramOrderId          String?
  trackingNumber         String?
  carrierName            String?
  shippedAt              DateTime?
  deliveredAt            DateTime?

  customerNotes          String?
  adminNotes             String?

  items                  OrderItem[]

  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([orderNumber])
}

// ---------------------------------------------------------------------------
// OrderItem
// ---------------------------------------------------------------------------

model OrderItem {
  id                   String  @id @default(cuid())

  order                Order   @relation(fields: [orderId], references: [id])
  orderId              String

  productId            String
  productName          String
  productSlug          String
  partNumber           String
  quantity             Int
  priceNetto           Int
  totalNetto           Int
  note                 String?
  ingramPriceSnapshot  Int?
}

// ---------------------------------------------------------------------------
// AdminUser
// ---------------------------------------------------------------------------

model AdminUser {
  id             String    @id @default(cuid())
  email          String    @unique
  hashedPassword String
  name           String
  role           AdminRole @default(ADMIN)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Quote (Oferta)
// ---------------------------------------------------------------------------

model Quote {
  id              String      @id @default(cuid())
  quoteNumber     String      @unique

  status          QuoteStatus @default(DRAFT)

  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id])

  clientCompany   String
  clientNip       String?
  clientContact   String?
  clientEmail     String?
  clientPhone     String?
  clientAddress   String?

  validUntil      DateTime
  paymentTerms    String      @default("7 dni")
  deliveryTerms   String      @default("2-5 dni roboczych")
  notes           String?
  internalNotes   String?

  subtotalNetto   Int
  vatAmount       Int
  totalBrutto     Int

  freebiesNote    String?

  items           QuoteItem[]

  sentAt          DateTime?
  acceptedAt      DateTime?
  pdfUrl          String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status])
  @@index([quoteNumber])
}

// ---------------------------------------------------------------------------
// QuoteItem (Pozycja oferty)
// ---------------------------------------------------------------------------

model QuoteItem {
  id              String  @id @default(cuid())

  quote           Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId         String

  position        Int

  source          String  @default("catalog")

  productId       String?
  productName     String
  partNumber      String?
  description     String?

  quantity        Int

  purchasePrice   Int?
  priceNetto      Int
  totalNetto      Int

  marginPercent   Float?
}
