// TAKMA e-commerce — Prisma schema
// PostgreSQL, modele: Customer, Order, OrderItem

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  AWAITING_PAYMENT
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum PaymentMethod {
  ONLINE
  PROFORMA
}

enum QuoteStatus {
  REQUESTED
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
  REJECTED
}

enum AdminRole {
  ADMIN
  MANAGER
}

// ---------------------------------------------------------------------------
// Customer
// ---------------------------------------------------------------------------

model Customer {
  id                String    @id @default(cuid())
  email             String    @unique
  firstName         String
  lastName          String
  company           String
  nip               String?
  phone             String?
  address           String?
  shippingAddress   String?
  stripeCustomerId  String?   @unique
  hashedPassword    String?   // null = customer has not activated account yet
  isActive          Boolean   @default(false)
  activatedAt       DateTime?

  orders            Order[]
  invoices          Invoice[]
  quotes            Quote[]
  devices           Device[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Device (customer equipment tracking)
// ---------------------------------------------------------------------------

model Device {
  id              String    @id @default(cuid())

  customer        Customer  @relation(fields: [customerId], references: [id])
  customerId      String

  productName     String    // e.g. "Zebra TC22"
  productSlug     String?   // link to product page
  partNumber      String?
  serialNumber    String?

  purchaseDate    DateTime?
  warrantyEnd     DateTime?
  oneCareEnd      DateTime? // Zebra OneCare service contract

  notes           String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Order
// ---------------------------------------------------------------------------

model Order {
  id                     String        @id @default(cuid())
  orderNumber            String        @unique
  status                 OrderStatus   @default(PENDING_PAYMENT)

  customer               Customer      @relation(fields: [customerId], references: [id])
  customerId             String

  subtotalNetto          Int
  vatAmount              Int
  shippingNetto          Int           @default(0)
  totalBrutto            Int

  paymentMethod          PaymentMethod @default(ONLINE)
  stripeSessionId        String?
  stripePaymentIntentId  String?

  proformaUrl            String?
  proformaSentAt         DateTime?
  paidAt                 DateTime?

  ingramOrderId          String?
  trackingNumber         String?
  carrierName            String?
  shippedAt              DateTime?
  deliveredAt            DateTime?

  customerNotes          String?
  adminNotes             String?

  items                  OrderItem[]
  invoices               Invoice[]

  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([orderNumber])
}

// ---------------------------------------------------------------------------
// OrderItem
// ---------------------------------------------------------------------------

model OrderItem {
  id                   String  @id @default(cuid())

  order                Order   @relation(fields: [orderId], references: [id])
  orderId              String

  productId            String
  productName          String
  productSlug          String
  partNumber           String
  quantity             Int
  priceNetto           Int
  totalNetto           Int
  note                 String?
  ingramPriceSnapshot  Int?
}

// ---------------------------------------------------------------------------
// AdminUser
// ---------------------------------------------------------------------------

model AdminUser {
  id             String    @id @default(cuid())
  email          String    @unique
  hashedPassword String
  name           String
  role           AdminRole @default(ADMIN)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Quote (Oferta)
// ---------------------------------------------------------------------------

model Quote {
  id              String      @id @default(cuid())
  quoteNumber     String      @unique

  status          QuoteStatus @default(DRAFT)

  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id])

  clientCompany   String
  clientNip       String?
  clientContact   String?
  clientEmail     String?
  clientPhone     String?
  clientAddress   String?

  validUntil      DateTime
  paymentTerms    String      @default("7 dni")
  deliveryTerms   String      @default("2-5 dni roboczych")
  notes           String?
  internalNotes   String?

  subtotalNetto   Int
  vatAmount       Int
  totalBrutto     Int

  freebiesNote    String?

  items           QuoteItem[]

  sentAt          DateTime?
  acceptedAt      DateTime?
  pdfUrl          String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status])
  @@index([quoteNumber])
}

// ---------------------------------------------------------------------------
// QuoteItem (Pozycja oferty)
// ---------------------------------------------------------------------------

model QuoteItem {
  id              String  @id @default(cuid())

  quote           Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId         String

  position        Int

  source          String  @default("catalog")

  productId       String?
  productName     String
  partNumber      String?
  description     String?

  quantity        Int

  purchasePrice   Int?
  priceNetto      Int
  totalNetto      Int

  marginPercent   Float?
}

// ---------------------------------------------------------------------------
// SEO Agent — Enums
// ---------------------------------------------------------------------------

enum SeoReportStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum SeoAlertSeverity {
  CRITICAL
  WARNING
  INFO
}

// ---------------------------------------------------------------------------
// SEO Agent — SeoReport (główna tabela raportów)
// ---------------------------------------------------------------------------

model SeoReport {
  id            String          @id @default(cuid())
  generatedAt   DateTime        @default(now())
  periodStart   DateTime
  periodEnd     DateTime
  status        SeoReportStatus @default(RUNNING)

  scoreOverall  Int             @default(0)
  scoreSeo      Int             @default(0)
  scoreAeo      Int             @default(0)
  scoreGeo      Int             @default(0)
  scoreDelta    Int             @default(0)
  alertsCount   Int             @default(0)

  reportJson    Json?           // Pełny raport JSON (GSC + GA4 + scoring)
  errorMessage  String?

  metrics       SeoMetricsHistory[]
  serpPositions SeoSerpPosition[]
  competitors   SeoCompetitorSnapshot[]
  alerts        SeoAlert[]

  createdAt     DateTime        @default(now())

  @@index([generatedAt(sort: Desc)])
  @@index([status])
}

// ---------------------------------------------------------------------------
// SEO Agent — SeoMetricsHistory (time-series do wykresów)
// ---------------------------------------------------------------------------

model SeoMetricsHistory {
  id               String    @id @default(cuid())

  report           SeoReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId         String

  date             DateTime
  totalClicks      Int?
  totalImpressions Int?
  avgCtr           Float?
  avgPosition      Float?
  totalSessions    Int?
  totalConversions Int?

  createdAt        DateTime  @default(now())

  @@index([reportId])
  @@index([date(sort: Desc)])
}

// ---------------------------------------------------------------------------
// SEO Agent — SeoSerpPosition (per keyword per report)
// ---------------------------------------------------------------------------

model SeoSerpPosition {
  id                   String    @id @default(cuid())

  report               SeoReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId             String

  keyword              String
  keywordGroup         String?   // "brand", "generic", "comparison"
  takmaPosition        Int?      // null = nie rankuje
  competitorPositions  Json?     // {"bcmarket": 5, "aspekt": null, ...}
  hasRichSnippet       Boolean   @default(false)
  searchVolume         Int?

  createdAt            DateTime  @default(now())

  @@index([reportId])
  @@index([keyword, createdAt(sort: Desc)])
}

// ---------------------------------------------------------------------------
// SEO Agent — SeoCompetitorSnapshot
// ---------------------------------------------------------------------------

model SeoCompetitorSnapshot {
  id              String    @id @default(cuid())

  report          SeoReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId        String

  competitor      String
  url             String
  title           String?
  metaDescription String?
  contentLength   Int?
  hasPrice        Boolean   @default(false)
  price           String?
  hasFaq          Boolean   @default(false)
  faqCount        Int       @default(0)
  hasSchema       Boolean   @default(false)
  schemaTypes     String[]
  contentHash     String?
  contentChanged  Boolean   @default(false)

  createdAt       DateTime  @default(now())

  @@index([reportId])
  @@index([competitor, contentHash])
}

// ---------------------------------------------------------------------------
// SEO Agent — SeoAlert
// ---------------------------------------------------------------------------

model SeoAlert {
  id          String           @id @default(cuid())

  report      SeoReport        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId    String

  severity    SeoAlertSeverity
  category    String           // "ranking", "competitor", "technical", "content", "aeo"
  title       String
  description String?
  action      String?

  isRead      Boolean          @default(false)
  isResolved  Boolean          @default(false)

  createdAt   DateTime         @default(now())

  @@index([reportId])
  @@index([isRead, severity])
}

// ---------------------------------------------------------------------------
// Jarltech Stock Cache (synced by daily cron)
// ---------------------------------------------------------------------------

model JarltechStockCache {
  partNumber   String   @id
  found        Boolean  @default(false)
  unitPrice    Float?
  currency     String?  @default("EUR")
  inventory    Int      @default(0)
  incomingQty  Int      @default(0)
  incomingDate String?
  totalStock   Int      @default(0)
  jarltechId   String?
  availability String   @default("unavailable")
  deliveryText String?
  lastSync     DateTime @updatedAt
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// KSeF Invoice
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  PENDING
  SENT
  ACCEPTED
  REJECTED
  ERROR
}

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique  // e.g. FV/2026/04/001

  order           Order         @relation(fields: [orderId], references: [id])
  orderId         String

  customer        Customer      @relation(fields: [customerId], references: [id])
  customerId      String

  // Amounts (in grosze, like Order)
  subtotalNetto   Int
  vatAmount       Int
  totalBrutto     Int
  vatRate         Int           @default(23)

  // Dates
  issueDate       DateTime      @default(now())
  saleDate        DateTime?
  dueDate         DateTime?

  // Seller info (cached)
  sellerName      String        @default("TAKMA Tadeusz Tiuchty")
  sellerNip       String        @default("9151004377")
  sellerAddress   String        @default("ul. Poświęcka 1a, 51-128 Wrocław")

  // Buyer info (cached from customer)
  buyerName       String
  buyerNip        String?
  buyerAddress    String?

  // KSeF integration
  ksefStatus      InvoiceStatus @default(DRAFT)
  ksefNumber      String?       // KSeF reference number (e.g. 1234567890-20260404-ABC123DEF456)
  ksefSessionId   String?
  ksefXml         String?       // Generated FA(3) XML content
  ksefUpo         String?       // UPO (Urzędowe Potwierdzenie Odbioru) XML
  ksefError       String?       // Error message from KSeF
  ksefSentAt      DateTime?
  ksefAcceptedAt  DateTime?

  // Line items stored as JSON
  items           Json          // Array of { name, quantity, unitPrice, totalNetto, vatRate, totalBrutto }

  // PDF
  pdfUrl          String?

  notes           String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([orderId])
  @@index([customerId])
  @@index([ksefStatus])
  @@index([issueDate])
}

// ---------------------------------------------------------------------------
// SEO Digest (daily RSS feed aggregation)
// ---------------------------------------------------------------------------

model SeoDigestArticle {
  id            String   @id @default(cuid())
  guid          String   @unique  // RSS guid or link as unique identifier
  source        String   // e.g. "searchengineland", "semrush", "moz"
  sourceName    String   // e.g. "Search Engine Land"
  originalTitle String
  originalUrl   String
  titlePl       String?  // Polish translation
  summaryPl     String?  // Polish summary
  contentPl     String?  // Full article translated to Polish
  author        String?
  publishedAt   DateTime?
  fetchedAt     DateTime @default(now())
  isRead        Boolean  @default(false)
  isStarred     Boolean  @default(false)

  @@index([source, fetchedAt])
  @@index([isRead, fetchedAt])
}
