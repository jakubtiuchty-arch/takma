// TAKMA e-commerce — Prisma schema
// PostgreSQL, modele: Customer, Order, OrderItem

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  AWAITING_PAYMENT
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum PaymentMethod {
  ONLINE
  PROFORMA
}

enum QuoteStatus {
  REQUESTED
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
  REJECTED
}

enum AdminRole {
  ADMIN
  MANAGER
}

// ---------------------------------------------------------------------------
// Customer
// ---------------------------------------------------------------------------

model Customer {
  id               String    @id @default(cuid())
  email            String    @unique
  firstName        String
  lastName         String
  company          String
  nip              String?
  phone            String?
  address          String?
  shippingAddress  String?
  stripeCustomerId String?   @unique
  hashedPassword   String? // null = customer has not activated account yet
  isActive         Boolean   @default(false)
  activatedAt      DateTime?

  orders   Order[]
  invoices Invoice[]
  quotes   Quote[]
  devices  Device[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Device (customer equipment tracking)
// ---------------------------------------------------------------------------

model Device {
  id String @id @default(cuid())

  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String

  productName  String // e.g. "Zebra TC22"
  productSlug  String? // link to product page
  partNumber   String?
  serialNumber String?

  purchaseDate DateTime?
  warrantyEnd  DateTime?
  oneCareEnd   DateTime? // Zebra OneCare service contract

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Order
// ---------------------------------------------------------------------------

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  status      OrderStatus @default(PENDING_PAYMENT)

  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String

  subtotalNetto Int
  vatAmount     Int
  shippingNetto Int @default(0)
  totalBrutto   Int

  paymentMethod         PaymentMethod @default(ONLINE)
  stripeSessionId       String?
  stripePaymentIntentId String?
  p24SessionId          String?       @unique // nasz identyfikator sesji P24 (= order.id)
  p24OrderId            String? // orderId nadany przez P24 (String — wartości > zakres int4, np. 4506613438)

  proformaUrl    String?
  proformaSentAt DateTime?
  paidAt         DateTime?

  ingramOrderId  String?
  trackingNumber String?
  carrierName    String?
  shipmentId     String? // id paczki Furgonetka (do ponownego pobrania etykiety, bez duplikatu)
  shippedAt      DateTime?
  deliveredAt    DateTime?

  customerNotes String?
  adminNotes    String?

  items     OrderItem[]
  invoices  Invoice[]
  shipments OrderShipment[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  // --- Atrybucja marketingowa (droga od kliknięcia) ---
  gclid             String?
  gclidAt           DateTime?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  landingPage       String?
  journey           String? // ścieżka wizyty: JSON array stron
  adsCampaign       String? // rozwiązane z click_view
  adsAdGroup        String?
  adsKeyword        String?
  adsClickCost Int?
  adsResolvedAt     DateTime?
  adsConvUploadedAt DateTime? // kiedy wysłano konwersję offline (marża) do Google Ads

  @@index([status])
  @@index([customerId])
  @@index([orderNumber])
}

// ---------------------------------------------------------------------------
// OrderShipment — wiele przesyłek per zamówienie (część sprzętu z różnych
// lokalizacji). Furgonetka (shipmentId=id paczki) lub ręczny numer (shipmentId=null).
// Legacy: stare zamówienia mają numer w Order.trackingNumber (renderowany syntetycznie).
// ---------------------------------------------------------------------------

model OrderShipment {
  id String @id @default(cuid())

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String

  carrierName    String
  trackingNumber String?
  shipmentId     String? // id paczki Furgonetka (null = numer wpisany ręcznie)
  source         String    @default("manual") // 'furgonetka' | 'manual'
  emailedAt      DateTime?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([shipmentId])
}

// ---------------------------------------------------------------------------
// OrderItem
// ---------------------------------------------------------------------------

model OrderItem {
  id String @id @default(cuid())

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String

  productId           String
  productName         String
  productSlug         String
  partNumber          String
  quantity            Int
  priceNetto          Int
  totalNetto          Int
  note                String?
  ingramPriceSnapshot Int?
}

// ---------------------------------------------------------------------------
// AdminUser
// ---------------------------------------------------------------------------

model AdminUser {
  id             String    @id @default(cuid())
  email          String    @unique
  hashedPassword String
  name           String
  role           AdminRole @default(ADMIN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Quote (Oferta)
// ---------------------------------------------------------------------------

model Quote {
  id          String @id @default(cuid())
  quoteNumber String @unique

  status QuoteStatus @default(DRAFT)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  clientCompany String
  clientNip     String?
  clientContact String?
  clientEmail   String?
  clientPhone   String?
  clientAddress String?

  validUntil    DateTime
  paymentTerms  String   @default("7 dni")
  deliveryTerms String   @default("2-5 dni roboczych")
  notes         String?
  internalNotes String?

  subtotalNetto Int
  vatAmount     Int
  totalBrutto   Int

  freebiesNote String?

  zebraServiceBanner Boolean @default(false)

  items QuoteItem[]

  sentAt     DateTime?
  acceptedAt DateTime?
  pdfUrl     String?

  // Token do linku „zamów z oferty" w mailu (/oferta/[numer]/zamow?t=…).
  // Bez niego numer oferty wystarczyłby do podejrzenia cudzej wyceny.
  orderToken String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([quoteNumber])
}

// ---------------------------------------------------------------------------
// QuoteItem (Pozycja oferty)
// ---------------------------------------------------------------------------

model QuoteItem {
  id String @id @default(cuid())

  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId String

  position Int

  source String @default("catalog")

  productId   String?
  productName String
  partNumber  String?
  description String?

  quantity Int

  purchasePrice Int?
  priceNetto    Int
  totalNetto    Int

  marginPercent Float?

  // Cena sklepowa z dnia wystawienia oferty (grosze) — pokazywana w mailu jako
  // przekreślona, żeby klient widział wysokość rabatu. Zamrożona celowo: gdyby
  // czytać ją na żywo, rabat zmieniałby się sam po każdej zmianie cennika.
  catalogPriceNetto Int?
  discountPercent   Float?
}

// ---------------------------------------------------------------------------
// SEO Agent — Enums
// ---------------------------------------------------------------------------

enum SeoReportStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum SeoAlertSeverity {
  CRITICAL
  WARNING
  INFO
}

// ---------------------------------------------------------------------------
// SEO Agent — SeoReport (główna tabela raportów)
// ---------------------------------------------------------------------------

model SeoReport {
  id          String          @id @default(cuid())
  generatedAt DateTime        @default(now())
  periodStart DateTime
  periodEnd   DateTime
  status      SeoReportStatus @default(RUNNING)

  scoreOverall Int @default(0)
  scoreSeo     Int @default(0)
  scoreAeo     Int @default(0)
  scoreGeo     Int @default(0)
  scoreDelta   Int @default(0)
  alertsCount  Int @default(0)

  reportJson   Json? // Pełny raport JSON (GSC + GA4 + scoring)
  errorMessage String?

  metrics       SeoMetricsHistory[]
  serpPositions SeoSerpPosition[]
  competitors   SeoCompetitorSnapshot[]
  alerts        SeoAlert[]

  createdAt DateTime @default(now())

  @@index([generatedAt(sort: Desc)])
  @@index([status])
}

// ---------------------------------------------------------------------------
// SEO Agent — SeoMetricsHistory (time-series do wykresów)
// ---------------------------------------------------------------------------

model SeoMetricsHistory {
  id String @id @default(cuid())

  report   SeoReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId String

  date             DateTime
  totalClicks      Int?
  totalImpressions Int?
  avgCtr           Float?
  avgPosition      Float?
  totalSessions    Int?
  totalConversions Int?

  createdAt DateTime @default(now())

  @@index([reportId])
  @@index([date(sort: Desc)])
}

// ---------------------------------------------------------------------------
// SEO Agent — SeoSerpPosition (per keyword per report)
// ---------------------------------------------------------------------------

model SeoSerpPosition {
  id String @id @default(cuid())

  report   SeoReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId String

  keyword             String
  keywordGroup        String? // "brand", "generic", "comparison"
  takmaPosition       Int? // null = nie rankuje
  competitorPositions Json? // {"bcmarket": 5, "aspekt": null, ...}
  hasRichSnippet      Boolean @default(false)
  searchVolume        Int?

  createdAt DateTime @default(now())

  @@index([reportId])
  @@index([keyword, createdAt(sort: Desc)])
}

// ---------------------------------------------------------------------------
// SEO Agent — SeoCompetitorSnapshot
// ---------------------------------------------------------------------------

model SeoCompetitorSnapshot {
  id String @id @default(cuid())

  report   SeoReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId String

  competitor      String
  url             String
  title           String?
  metaDescription String?
  contentLength   Int?
  hasPrice        Boolean  @default(false)
  price           String?
  hasFaq          Boolean  @default(false)
  faqCount        Int      @default(0)
  hasSchema       Boolean  @default(false)
  schemaTypes     String[]
  contentHash     String?
  contentChanged  Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([reportId])
  @@index([competitor, contentHash])
}

// ---------------------------------------------------------------------------
// SEO Agent — SeoAlert
// ---------------------------------------------------------------------------

model SeoAlert {
  id String @id @default(cuid())

  report   SeoReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId String

  severity    SeoAlertSeverity
  category    String // "ranking", "competitor", "technical", "content", "aeo"
  title       String
  description String?
  action      String?

  isRead     Boolean @default(false)
  isResolved Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([reportId])
  @@index([isRead, severity])
}

// ---------------------------------------------------------------------------
// Jarltech Stock Cache (synced by daily cron)
// ---------------------------------------------------------------------------

model JarltechStockCache {
  partNumber   String   @id
  found        Boolean  @default(false)
  unitPrice    Float?
  currency     String?  @default("EUR")
  inventory    Int      @default(0)
  incomingQty  Int      @default(0)
  incomingDate String?
  totalStock   Int      @default(0)
  jarltechId   String?
  availability String   @default("unavailable")
  deliveryText String?
  lastSync     DateTime @updatedAt
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// KSeF Invoice
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  PENDING
  SENT
  ACCEPTED
  REJECTED
  ERROR
}

model Invoice {
  id            String @id @default(cuid())
  invoiceNumber String @unique // e.g. FV/2026/04/001

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String

  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String

  // Amounts (in grosze, like Order)
  subtotalNetto Int
  vatAmount     Int
  totalBrutto   Int
  vatRate       Int @default(23)

  // Dates
  issueDate DateTime  @default(now())
  saleDate  DateTime?
  dueDate   DateTime?

  // Seller info (cached)
  sellerName    String @default("TAKMA Tadeusz Tiuchty")
  sellerNip     String @default("9151004377")
  sellerAddress String @default("ul. Poświęcka 1a, 51-128 Wrocław")

  // Buyer info (cached from customer)
  buyerName    String
  buyerNip     String?
  buyerAddress String?

  // KSeF integration
  ksefStatus     InvoiceStatus @default(DRAFT)
  ksefNumber     String? // KSeF reference number (e.g. 1234567890-20260404-ABC123DEF456)
  ksefSessionId  String?
  ksefXml        String? // Generated FA(3) XML content
  ksefUpo        String? // UPO (Urzędowe Potwierdzenie Odbioru) XML
  ksefError      String? // Error message from KSeF
  ksefSentAt     DateTime?
  ksefAcceptedAt DateTime?

  // Line items stored as JSON
  items Json // Array of { name, quantity, unitPrice, totalNetto, vatRate, totalBrutto }

  // PDF
  pdfUrl String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([customerId])
  @@index([ksefStatus])
  @@index([issueDate])
}

// ---------------------------------------------------------------------------
// Stock Cache (universal stock sync — all products except M3/Jarltech)
// ---------------------------------------------------------------------------

model StockCache {
  partNumber   String   @id
  found        Boolean  @default(false)
  price        Float? // sell price (with margin)
  priceBrutto  Float?
  ingramPrice  Float? // purchase price
  stockPL      Int      @default(0)
  stockDE      Int      @default(0)
  inDelivery   Int      @default(0)
  totalStock   Int      @default(0)
  availability String   @default("unavailable") // available, on-order, unavailable
  deliveryText String?
  lastSync     DateTime @updatedAt
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// SEO Digest (daily RSS feed aggregation)
// ---------------------------------------------------------------------------

model SeoDigestArticle {
  id            String    @id @default(cuid())
  guid          String    @unique // RSS guid or link as unique identifier
  source        String // e.g. "searchengineland", "semrush", "moz"
  sourceName    String // e.g. "Search Engine Land"
  originalTitle String
  originalUrl   String
  titlePl       String? // Polish translation
  summaryPl     String? // Polish summary
  contentPl     String? // Full article translated to Polish
  author        String?
  publishedAt   DateTime?
  fetchedAt     DateTime  @default(now())
  isRead        Boolean   @default(false)
  isStarred     Boolean   @default(false)

  @@index([source, fetchedAt])
  @@index([isRead, fetchedAt])
}

/// Logi rozmów z Doradcą materiałów (AI) — wgląd w pytania klientów.
model DoradcaLog {
  id        String   @id @default(cuid())
  sessionId String
  role      String // 'user' | 'assistant'
  content   String   @db.Text
  ip        String?
  pathname  String?
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([createdAt])
}

model AllegroToken {
  id           String   @id @default(cuid())
  environment  String   @unique // "sandbox" | "prod"
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  expiresAt    DateTime
  scope        String   @db.Text
  allegroLogin String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Oferta wystawiona z katalogu TAKMA na Allegro (1 wariant = 1 oferta).
// Tworzona jako DRAFT (publication INACTIVE) — aktywację robi się w panelu Allegro.
model AllegroOffer {
  id             String   @id @default(cuid())
  environment    String // "sandbox" | "prod"
  partNumber     String
  seriesSlug     String?
  productKind    String   @default("ribbon") // "ribbon" | "label"
  allegroId      String? // id oferty zwrócone przez Allegro
  allegroUrl     String?
  status         String   @default("DRAFT") // DRAFT | ACTIVE | ERROR
  priceNet       Float?
  priceGross     Float?
  stockAvailable Int? // ostatni stan wypchnięty do Allegro (do synchronizacji)
  lastError      String?  @db.Text
  payload        String?  @db.Text // ostatni wysłany payload (debug)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([environment, partNumber])
}

// Auto-odpowiedź na pierwszą wiadomość klienta na Allegro (1 wątek = 1 wpis).
// Zapobiega podwójnej auto-odpowiedzi i podwójnemu powiadomieniu handlowca.
model AllegroAutoReply {
  threadId  String   @id
  repliedAt DateTime @default(now())
  notified  Boolean  @default(false)
}

// Powiadomienie handlowca o nowym zamówieniu Allegro (1 zamówienie = 1 mail).
model AllegroOrderNotified {
  orderId        String    @id
  notifiedAt     DateTime  @default(now())
  // numer listu przewozowego (Furgonetka) — gdy utworzymy przesyłkę
  trackingNumber String?
  shipmentId     String?
  // wewnętrzny znacznik działu realizacji (niezależny od statusu Allegro)
  fulfilled      Boolean   @default(false)
  fulfilledAt    DateTime?
}

// EAN/GTIN produktów (master data od dystrybutora) — do wystawiania na Allegro.
// Źródło: content feed Ingram (DescriptionPL.csv, kolumny ProductCode/EANCode).
model ProductEan {
  partNumber String   @id
  ean        String
  source     String   @default("ingram")
  updatedAt  DateTime @updatedAt
}

// Walidacja feedów porównywarek (Ceneo, Google Merchant) — 1 wpis = 1 sprawdzenie.
model FeedValidationRun {
  id          String   @id @default(cuid())
  feed        String // 'ceneo' | 'merchant'
  startedAt   DateTime @default(now())
  ok          Boolean  @default(false)
  httpStatus  Int?
  totalOffers Int      @default(0)
  withEan     Int      @default(0)
  prevTotal   Int?
  minPrice    Float?
  maxPrice    Float?
  errors      String?  @db.Text // JSON: string[]
  warnings    String?  @db.Text // JSON: string[]
  durationMs  Int?

  @@index([feed, startedAt(sort: Desc)])
  @@map("feed_validation_runs")
}

// Śledzenie przesyłek Furgonetki — własna oś czasu budowana cronem (API Furgonetki
// nie ma historii zdarzeń, więc pollujemy bieżący stan i dopisujemy zmiany).
model ShipmentTracking {
  id             String    @id @default(cuid())
  packageId      String    @unique // id paczki Furgonetka
  source         String // 'allegro' | 'shop'
  orderRef       String // id zamówienia (Allegro order id / shop order id)
  trackingNumber String?
  carrier        String?
  currentState   String?
  currentDesc    String?
  currentStation String?
  trackingUrl    String?
  delivered      Boolean   @default(false)
  lastPolledAt   DateTime?
  createdAt      DateTime  @default(now())

  events ShipmentTrackingEvent[]

  @@index([orderRef])
  @@index([delivered])
  @@map("shipment_tracking")
}

model ShipmentTrackingEvent {
  id             String           @id @default(cuid())
  tracking       ShipmentTracking @relation(fields: [trackingId], references: [id], onDelete: Cascade)
  trackingId     String
  state          String
  description    String?
  station        String?
  datetimeStatus String? // ISO od Furgonetki (kiedy kurier zeskanował)
  recordedAt     DateTime         @default(now())

  @@index([trackingId, recordedAt])
  @@map("shipment_tracking_events")
}

// Codzienna analiza AI ruchu z GA4 (panel /admin/analytics). 1 wpis = 1 dzień.
model GaDigest {
  id        String   @id @default(cuid())
  date      String   @unique // YYYY-MM-DD (dzień analizy = wczoraj)
  summary   String   @db.Text // markdown: analiza Claude
  metrics   String?  @db.Text // JSON: snapshot kluczowych liczb (current/previous)
  createdAt DateTime @default(now())

  @@map("ga_digest")
}

// Dialog właściciela z AI o analizie ruchu — kontekst, który AI uwzględnia
// w codziennej analizie (np. wyjaśnione anomalie, których nie ma już zgłaszać).
model GaChatMessage {
  id        String   @id @default(cuid())
  role      String // 'user' | 'assistant'
  content   String   @db.Text
  pinned    Boolean  @default(false) // trwały kontekst — zawsze trafia do codziennej analizy
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("ga_chat_message")
}

// Log odwiedzin na żywo — IP + strona + miasto, do podglądu „kto teraz na stronie"
// w /admin/analytics. RODO: dane techniczne (uzasadniony interes/ops), tylko admin,
// retencja 48 h (auto-kasowanie przy odczycie). NIE łączymy z danymi osobowymi klienta.
model LiveVisitor {
  id        String   @id @default(cuid())
  ip        String
  path      String
  city      String?
  country   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("live_visitor")
}

// Wizytówka Google (Google Business Profile) — panel /admin/wizytowka.
// Snapshot stanu profilu (z Places API) — historia do trendów i wykrywania zmian (ochrona).
model GbpSnapshot {
  id        String   @id @default(cuid())
  data      String   @db.Text // JSON: znormalizowany profil (ocena, opinie, godziny, kategorie, zdjęcia...)
  rating    Float? // szybki dostęp do trendu
  reviews   Int? // liczba opinii
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("gbp_snapshot")
}

// AI „inteligentne zadania" optymalizacji wizytówki + zapisany audyt (markdown).
model GbpTask {
  id        String   @id @default(cuid())
  title     String
  detail    String   @db.Text
  proposal  String?  @db.Text // gotowa do wklejenia treść/wartość (np. draft opisu, kategoria, lista usług)
  where     String? // gdzie w GBP to wkleić (np. "Edytuj profil → Opis")
  priority  String   @default("med") // high | med | low
  category  String   @default("ogolne") // opinie | tresc | zdjecia | dane | aktywnosc | ogolne
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("gbp_task")
}

// Najnowszy audyt AI wizytówki (1 aktywny wpis = ostatni; trzymamy markdown + score).
model GbpAudit {
  id        String   @id @default(cuid())
  summary   String   @db.Text // markdown
  score     Int? // 0-100 kompletność/jakość
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("gbp_audit")
}

// Dialog właściciela z AI o strategii wizytówki (jak GaChatMessage dla analytics).
model GbpChatMessage {
  id        String   @id @default(cuid())
  role      String // user | assistant
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("gbp_chat_message")
}

// Leady z formularzy (kontakt, zapytanie o produkt) + atrybucja
model Lead {
  id          String  @id @default(cuid())
  source      String // 'kontakt' | 'inquiry'
  name        String?
  email       String?
  phone       String?
  subject     String?
  message     String? @db.Text
  productSlug String?

  gclid String?

  gclidAt     DateTime?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  landingPage String?
  journey     String? // JSON array stron

  adsCampaign   String?
  adsAdGroup    String?
  adsKeyword    String?
  adsClickCost Int?
  adsResolvedAt DateTime?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([gclid])
}

// Tabela agenta AI kokpitu (kokpit-lyart.vercel.app) — pisana przez kokpit przez `pg`,
// tu zamapowana tylko po to, żeby `db push` jej nie kasował.
model KokpitAiDigest {
  id        Int      @id @default(autoincrement())
  site      String
  kind      String
  periodEnd DateTime @map("period_end") @db.Date
  content   String
  urgent    String?
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([site, kind, periodEnd])
  @@map("kokpit_ai_digest")
}

// Monitor przetargów AutoID (BZP e-Zamówienia)
model Tender {
  id                   String    @id @default(cuid())
  noticeNumber         String    @unique
  bzpNumber            String?
  objectId             String?
  source               String    @default("BZP")
  orderObject          String
  organizationName     String?
  organizationCity     String?
  organizationProvince String?
  cpvCodes             String?
  publicationDate      DateTime?
  submittingOffersDate DateTime?
  url                  String?
  score                Int       @default(0)
  aiReason             String?
  status               String    @default("new") // new | watched | dismissed
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status, score])
  @@index([submittingOffersDate])
  @@map("tenders")
}

/// Kod rabatowy na promocję producencką, wystawiany imiennie po zgłoszeniu
/// przez formularz na karcie produktu. Rabat Zebry pochodzi z vouchera na
/// konkretnego klienta końcowego, więc cena promocyjna nie może być dostępna
/// dla każdego, kto doda produkt do koszyka — kod wiąże ją z jednym zgłoszeniem,
/// jednym numerem katalogowym i jednym zamówieniem.
model PromoCode {
  id          String    @id @default(cuid())
  code        String    @unique
  sku         String    // numer katalogowy objęty ceną promocyjną
  priceNetto  Int       // cena promocyjna netto w groszach
  maxQty      Int       @default(3)
  productName String?
  productSlug String?
  name        String
  email       String
  phone       String?
  expiresAt   DateTime
  usedAt      DateTime?
  orderNumber String?
  revoked     Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([createdAt])
  @@map("promo_codes")
}

/// Urządzenie używane — jedna sztuka, jeden numer seryjny, jedna cena.
/// W odróżnieniu od katalogu (products.ts + żywe stany dystrybutorów) tu każdy
/// wiersz to konkretny egzemplarz z magazynu, więc po sprzedaży musi zniknąć z
/// oferty — status pilnuje, żeby dwie osoby nie kupiły tego samego terminala.
model UsedDevice {
  id             String    @id @default(cuid())
  slug           String    @unique
  name           String
  brand          String    @default("Zebra")
  category       String    @default("terminal") // terminal | drukarka | skaner | tablet | inne
  partNumber     String?
  serialNumber   String?   // wewnętrznie — na froncie nie pokazujemy

  conditionGrade String    @default("B") // A = jak nowe, B = ślady używania, C = widoczne zużycie
  conditionNote  String?   // co dokładnie widać na tej sztuce
  accessories    String?   // co jest w zestawie (zasilacz, bateria, stacja)
  description    String?
  specs          Json?     // pary nazwa/wartość do tabeli danych technicznych

  priceNetto     Int       // grosze
  newPriceNetto  Int?      // cena nowego egzemplarza — do porównania
  warrantyMonths Int       @default(6)

  images         String[]  @default([])

  status         String    @default("AVAILABLE") // AVAILABLE | RESERVED | SOLD
  orderNumber    String?
  soldAt         DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, createdAt])
  @@map("used_devices")
}
